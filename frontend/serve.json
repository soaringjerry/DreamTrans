{
  "rewrites": [
    {
      "source": "pro/admin/**",
      "destination": "/pro-admin.html"
    },
    {
      "source": "pro/admin",
      "destination": "/pro-admin.html"
    },
    {
      "source": "pro/study/**",
      "destination": "/study.html"
    },
    {
      "source": "pro/study",
      "destination": "/study.html"
    },
    {
      "source": "pro/**",
      "destination": "/pro.html"
    },
    {
      "source": "pro",
      "destination": "/pro.html"
    }
  ]
}
