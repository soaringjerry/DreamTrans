# ============================================
# DreamTrans Environment Configuration
# ============================================
# Copy this file to .env and fill in your values
# ============================================

# === Required ===
# Speechmatics API Key (for real-time transcription)
# Get yours at: https://www.speechmatics.com/
SM_API_KEY=your_speechmatics_api_key_here

# === OpenAI API (optional, for translation/chat) ===
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# === Server Configuration ===
PORT=8080

# === PostgreSQL (required for Pro features) ===
# Without PostgreSQL, Pro features will be disabled
DATABASE_URL=postgres://dreamtrans:dreamtrans_secret@localhost:5432/dreamtrans?sslmode=disable
POSTGRES_USER=dreamtrans
POSTGRES_PASSWORD=dreamtrans_secret

# === JWT Authentication (required for Pro features) ===
# Generate with: openssl rand -base64 48
JWT_SECRET=change_me_in_production_32chars!
JWT_REFRESH_SECRET=

# === System Settings ===
# Set to 'true' to allow users to use their own API keys
ALLOW_USER_API_KEY=false

# === Debug ===
OPENAI_DEBUG=0