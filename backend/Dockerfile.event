# Build stage
FROM golang:1.24-alpine AS builder

RUN apk add --no-cache git ca-certificates
WORKDIR /app/backend

COPY backend/go.mod backend/go.sum ./
RUN go mod download

COPY backend/ ./

# Ensure module graph includes event-worker deps (pcas sdk, etc.)
RUN go mod tidy

RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build \
    -ldflags="-w -s" \
    -tags=event_worker \
    -o dreamtrans-event \
    ./cmd/event-worker

# Runtime stage
FROM alpine:latest
RUN apk add --no-cache ca-certificates tzdata

WORKDIR /app
COPY --from=builder /app/backend/dreamtrans-event .
COPY --from=builder /app/backend/.env* ./

# No ports exposed; connects out to PCAS
ENV PCAS_ADDR=127.0.0.1:50051

USER root
CMD ["/app/dreamtrans-event"]
