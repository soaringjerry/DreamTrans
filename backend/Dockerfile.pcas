# Build stage: runs natively on the build machine and cross-compiles for
# TARGETARCH, so linux/arm64 images do not compile under QEMU.
FROM --platform=$BUILDPLATFORM golang:1.26.5-alpine AS builder

# Install build dependencies
RUN apk add --no-cache git ca-certificates

# Set working directory
WORKDIR /app/backend

# Copy go mod files
COPY backend/go.mod backend/go.sum ./

# Download dependencies
RUN go mod download

# Copy only source needed for the two binaries. Runtime credentials must never
# enter a build layer.
COPY backend/cmd ./cmd
COPY backend/internal ./internal

ARG MODE=event
ARG TARGETOS
ARG TARGETARCH
RUN echo "Build MODE=${MODE}"

# Build the DreamTrans event-driven worker by default
RUN test -n "$TARGETOS" && test -n "$TARGETARCH" && \
    if [ "$MODE" = "event" ]; then \
      CGO_ENABLED=0 GOOS="$TARGETOS" GOARCH="$TARGETARCH" go build -buildvcs=false -trimpath -ldflags="-w -s" -tags=event_worker -o /app/dreamtrans ./cmd/event-worker ; \
    else \
      CGO_ENABLED=0 GOOS="$TARGETOS" GOARCH="$TARGETARCH" go build -buildvcs=false -trimpath -ldflags="-w -s" -o /app/dreamtrans ./cmd/pcas-provider ; \
    fi

# Runtime stage
FROM alpine:3.22

# Install runtime dependencies
RUN apk add --no-cache ca-certificates tzdata

# Create a stable non-root identity for volume and runtime permissions.
RUN addgroup -S -g 10001 dreamtrans \
    && adduser -S -D -H -u 10001 -G dreamtrans dreamtrans

# Set working directory
WORKDIR /app

# Copy binary from builder
COPY --from=builder --chown=dreamtrans:dreamtrans /app/dreamtrans .

# Switch to non-root user
USER dreamtrans

EXPOSE 50052

# Run the DreamTrans process (event-worker by default)
CMD ["./dreamtrans"]
