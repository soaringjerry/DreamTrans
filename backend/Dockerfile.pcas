# Build stage
FROM golang:1.24-alpine AS builder

# Install build dependencies
RUN apk add --no-cache git ca-certificates

# Set working directory
WORKDIR /app/backend

# Copy go mod files
COPY backend/go.mod backend/go.sum ./

# Download dependencies
RUN go mod download

# Copy source code
COPY backend/ .

ARG MODE=event
RUN echo "Build MODE=${MODE}"

# Ensure module graph includes deps (pcas sdk, etc.)
RUN go mod tidy

# Build the DreamTrans event-driven worker by default
RUN if [ "$MODE" = "event" ]; then \
      CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -ldflags="-w -s" -tags=event_worker -o dreamtrans ./cmd/event-worker ; \
    else \
      CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -ldflags="-w -s" -o dreamtrans ./cmd/pcas-provider ; \
    fi

# Runtime stage
FROM alpine:latest

# Install runtime dependencies
RUN apk add --no-cache ca-certificates tzdata

# Create non-root user
RUN adduser -D -g '' appuser

# Set working directory
WORKDIR /app

# Copy binary from builder
COPY --from=builder /app/backend/dreamtrans .

# Copy .env file if it exists (optional)
COPY --from=builder /app/backend/.env* ./

# Change ownership to non-root user
RUN chown -R appuser:appuser /app

# Switch to non-root user
USER appuser

# No port exposure needed for event-driven mode

# Run the DreamTrans process (event-worker by default)
CMD ["./dreamtrans"]
